# 配置样例。
# 用法：复制为项目根目录下的 .env，或通过 SEAT_ENV_FILE 指定任意路径。
# 读取优先级：进程环境变量 > .env 文件 > 代码默认值；
# 已存在的进程环境变量不会被本文件覆盖。
# .env 已被 .gitignore 忽略；不要提交任何真实密码或令牌。

# 运行环境：development / dev / test / production / prod
# 其他值会导致启动失败（不会静默回退为开发环境）。
SEAT_ENV=development
# 未显式指定时：正式库 var/delivery.db，演示库 var/seat_demo.db
SEAT_DB_PATH=var/delivery.db
SEAT_HOST=127.0.0.1
SEAT_PORT=8010
SEAT_LOG_LEVEL=INFO
SEAT_LOG_JSON=false

# 会话
SEAT_SESSION_IDLE_MINUTES=30
SEAT_SESSION_ABSOLUTE_HOURS=8
# 生产环境必须为 true（否则启动失败）
SEAT_COOKIE_SECURE=false

# 只有在可信反向代理之后才设为 true；开启后会读取 X-Forwarded-For 作为来源 IP
SEAT_TRUST_PROXY=false

# 演示模式：仅 development / test 可用；生产环境开启会直接启动失败。
# 演示库默认使用 var/seat_demo.db，与正式库分离。
SEAT_DEMO_MODE=false
# 演示密码（可选）：不设置则在初始化时随机生成并只显示一次。
# 不要在本文件或仓库中保存真实密码。
# SEAT_DEMO_PASSWORD=

# 定时任务（每分钟扫描一次，NFR-02）
SEAT_SCHEDULER_ENABLED=true
SEAT_SCHEDULER_INTERVAL_SECONDS=60

# 门禁/闸机对接令牌；留空表示禁用 ACS 端点
SEAT_ACS_TOKEN=
