# 复制为 .env 后按部署环境修改；所有变量都有安全默认值。
SEAT_ENV=development
SEAT_DB_PATH=var/seat_reservation.db
SEAT_HOST=127.0.0.1
SEAT_PORT=8010
SEAT_LOG_LEVEL=INFO
SEAT_LOG_JSON=false

# 会话
SEAT_SESSION_IDLE_MINUTES=30
SEAT_SESSION_ABSOLUTE_HOURS=8
SEAT_COOKIE_SECURE=false

# 只有在可信反向代理之后才设为 true；开启后会读取 X-Forwarded-For 作为来源 IP
SEAT_TRUST_PROXY=false

# 定时任务（每分钟扫描一次，NFR-02）
SEAT_SCHEDULER_ENABLED=true
SEAT_SCHEDULER_INTERVAL_SECONDS=60

# 门禁/闸机对接令牌；留空表示禁用 ACS 端点
SEAT_ACS_TOKEN=
